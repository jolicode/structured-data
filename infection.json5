{
    "$schema": "tools/infection/vendor/infection/infection/resources/schema.json",
    // Mutation testing is scoped to the layers guarded by baseline-snapshot tests,
    // where a golden-file assert can pass while asserting nothing meaningful.
    "source": {
        "directories": [
            "src/Vocabularies/Validators",
            "src/Mapper"
        ]
    },
    "timeout": 30,
    // Floor for the covered-code mutation score, kept a little below the current
    // value (52% in November 2026) so the weekly run flags regressions without
    // flapping. The score slipped from ~60% as the validators grew faster than
    // their tests: raise this floor again as escaped mutants get killed.
    "minCoveredMsi": 50,
    "logs": {
        "text": "var/cache/infection/infection.log",
        "summary": "var/cache/infection/summary.log"
    },
    "tmpDir": "var/cache/infection",
    "phpUnit": {
        "customPath": "tools/phpunit/vendor/bin/phpunit"
    },
    "testFramework": "phpunit",
    "testFrameworkOptions": "--group=validation"
}
