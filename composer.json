{
    "name": "jolicode/structured-data",
    "description": "A PHP toolkit to validate and convert structured data: Schema.org and Google Rich Results validation, microdata/RDFa/JSON-LD extraction, and the W3C JSON-LD 1.1 algorithms.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "json-ld",
        "schema.org",
        "structured-data",
        "rich-results",
        "microdata",
        "rdfa",
        "seo"
    ],
    "homepage": "https://github.com/jolicode/structured-data",
    "authors": [
        {
            "name": "Hédic Guibert",
            "email": "hguibert@jolicode.com"
        },
        {
            "name": "Xavier Lacot",
            "email": "xlacot@jolicode.com"
        }
    ],
    "support": {
        "issues": "https://github.com/jolicode/structured-data/issues",
        "source": "https://github.com/jolicode/structured-data"
    },
    "require": {
        "php": "^8.4",
        "ext-dom": "*",
        "ext-json": "*",
        "ext-libxml": "*",
        "league/uri": "^7.8",
        "psr/log": "^1|^2|^3",
        "salsify/json-streaming-parser": "^8.3",
        "symfony/http-client-contracts": "^3.0"
    },
    "require-dev": {
        "ext-zip": "*",
        "nikic/php-parser": "^5.0",
        "symfony/console": "^8.0",
        "symfony/css-selector": "^8.0",
        "symfony/dom-crawler": "^8.0",
        "symfony/filesystem": "^8.0",
        "symfony/finder": "^8.0",
        "symfony/http-client": "^7.2|^8.0",
        "symfony/var-dumper": "^8.0"
    },
    "suggest": {
        "symfony/http-client": "To resolve remote JSON-LD @context documents (off by default; see the \"Loading remote contexts\" section of the README)."
    },
    "autoload": {
        "psr-4": {
            "JoliCode\\StructuredData\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JoliCode\\StructuredData\\Tests\\": "tests/",
            "JoliCode\\StructuredData\\Vocabularies\\Generators\\": "generators/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
