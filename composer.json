{
    "name": "jolicode/json-ld",
    "description": "A library to convert JSON-LD from one format to another",
    "type": "library",
    "autoload": {
        "psr-4": {
            "Jolicode\\JsonLd\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jolicode\\JsonLd\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Hédic Guibert",
            "email": "guiberthedic@gmail.com"
        }
    ],
    "require-dev": {
        "phpunit/phpunit": "^9",
        "symfony/var-dumper": "^6.2",
        "friendsofphp/php-cs-fixer": "^3.13",
        "phpstan/phpstan": "^1.9"
    },
    "require": {
        "php": ">=8.1",
        "symfony/console": "^6.2",
        "symfony/finder": "^6.2",
        "symfony/filesystem": "^6.2",
        "symfony/http-client": "^6.2",
        "league/uri": "^6.8",
        "symfony/http-kernel": "^6.2",
        "monolog/monolog": "^3.3"
    }
}
