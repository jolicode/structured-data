#!/usr/bin/env php
<?php

$loader = require __DIR__ . '/../vendor/autoload.php';

use Symfony\Component\Console\Application;
use Jolicode\JsonLd\Command\Algorithms\ExpandCommand;
use Jolicode\JsonLd\Command\Algorithms\FlattenCommand;
use Jolicode\JsonLd\Command\Generator\GenerateCommand;
use Jolicode\JsonLd\Command\Algorithms\ResetFixturesCommand;

$application = new Application('structured-data-validator');
$application->add(new FlattenCommand());
$application->add(new ExpandCommand());
$application->add(new ResetFixturesCommand());
$application->add(new GenerateCommand());

$application->run();
