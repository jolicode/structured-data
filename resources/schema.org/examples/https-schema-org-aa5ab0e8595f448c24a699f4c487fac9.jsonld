        "alternativeText" , "longDescription" ] ,

 "encodingFormat" : [
        "text/html" , "image/png" ,
        "text/javascript" , "text/css" ] ,

 "accessibilityAPI" : [
        "ARIA" , "UIAccessibility" ],
 "accessibilityControl" : [
        "fullKeyboardControl" , "fullTouchControl" ,
        "fullVoiceControl" , "fullMouseControl" ]
}