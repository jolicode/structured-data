includes:
    - phpstan-baseline.neon

parameters:
    level: 9
    paths:
        - src
        - generators
        - tests
        - .castor
        - castor.php
    scanFiles:
        - .castor.stub.php
    scanDirectories:
        - tools/phpunit/vendor
        - vendor
    tmpDir: tools/phpstan/var
    inferPrivatePropertyTypeFromConstructor: true
    ignoreErrors:
        - '#Argument of an invalid type stdClass supplied for foreach, only iterables are supported.#'
        # ValidationMapper type flexibility for handling both string and array keys
        -
            message: '#Parameter \#1 \$propertyKey of method JoliCode\\StructuredData\\Mapper\\SchemaOrgNameNormalizer::normalizePropertyKeyCase\(\) expects string, array\|string given\.#'
            path: src/Mapper/ValidationMapper.php

        # Test infrastructure uses reflection for validator introspection
        -
            message: '#Parameter \#1 \$objectOrClass of class ReflectionClass constructor expects class-string<T of object>\|T of object, string given\.#'
            path: tests/Validation/Google/GoogleValidatorInfrastructureTest.php
        -
            message: '#Parameter \#1 \$filename of function file_get_contents expects string, string\|false given\.#'
            path: tests/Validation/Google/GoogleValidatorInfrastructureTest.php
        -
            message: '#Offset 1 on array{list<string>, list<''ERROR''|''WARNING''>} on left side of \?\? always exists and is not nullable\.#'
            path: tests/Validation/Google/GoogleValidatorInfrastructureTest.php
