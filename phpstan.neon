parameters:
    level: 8
    paths:
        - src
        - tests
        - castor.php
    scanFiles:
        - .castor.stub.php
    scanDirectories:
        - tools/phpunit/vendor
        - vendor
    excludePaths:
        - src/Vocabularies/Generators/**
    tmpDir: tools/phpstan/var
    inferPrivatePropertyTypeFromConstructor: true
    ignoreErrors:
        - '#Argument of an invalid type stdClass supplied for foreach, only iterables are supported.#'
        - '#no value type specified in iterable type array#'
        - '#Test(Case)?::provide[a-zA-Z0-9_]+\(\) return type has no value type specified in iterable type#'
        # ValidationMapper type flexibility for handling both string and array keys
        -
            message: '#Parameter \#1 \$propertyKey of method Jolicode\\JsonLd\\Mapper\\ValidationMapper::normalizePropertyKeyCase\(\) expects string, array\|string given\.#'
            path: src/JsonLd/Mapper/ValidationMapper.php
        # GoogleValidator intentionally flexible with value types for generic validation
        -
            message: '#Parameter \#2 \$givenValue of method Jolicode\\Vocabularies\\Validators\\Google\\GoogleValidator::hasInvalidExactValue\(\) expects int\|string, bool\|float\|int\|string given\.#'
            path: src/Vocabularies/Validators/Google/GoogleValidator.php
        -
            message: '#Parameter \#3 \.\..\$values of function sprintf expects bool\|float\|int\|string\|null, array\|string\|null given\.#'
            path: src/Vocabularies/Validators/Google/GoogleValidator.php
        -
            message: '#Parameter \#3 \.\.\.\$values of function sprintf expects bool\|float\|int\|string\|null, array\|string\|null given\.#'
            path: src/Vocabularies/Validators/Google/Stack.php
        -
            message: '#Variable \$importFailed in isset\(\) is never defined\.#'
            path: src/Vocabularies/Validators/Google/Stack.php
        # SchemaOrgValidator has type narrowing from is_array check
        -
            message: '#Call to function is_array\(\) with non-empty-array will always evaluate to true\.#'
            path: src/Vocabularies/Validators/SchemaOrg/SchemaOrgValidator.php
        # Test infrastructure uses reflection for validator introspection
        -
            message: '#Parameter \#1 \$objectOrClass of class ReflectionClass constructor expects class-string<T of object>\|T of object, string given\.#'
            path: tests/Validation/Google/GoogleValidatorInfrastructureTest.php
        -
            message: '#Parameter \#1 \$filename of function file_get_contents expects string, string\|false given\.#'
            path: tests/Validation/Google/GoogleValidatorInfrastructureTest.php
        -
            message: '#Offset 1 on array{list<string>, list<''ERROR''|''WARNING''>} on left side of \?\? always exists and is not nullable\.#'
            path: tests/Validation/Google/GoogleValidatorInfrastructureTest.php
